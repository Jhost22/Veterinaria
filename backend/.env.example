# Copia este archivo a .env para desarrollo local
PORT=3000

# Conexión a PostgreSQL (local o la URL que te da Render)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/veterinaria
# Pon "true" si usas la URL EXTERNA de Render (la interna no necesita SSL)
DATABASE_SSL=false
# "true" crea/actualiza las tablas automáticamente (útil al empezar)
DB_SYNC=true

# Autenticación
JWT_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# Primer usuario administrador (se crea solo si la tabla de usuarios está vacía)
ADMIN_EMAIL=admin@veterinaria.com
ADMIN_PASSWORD=Admin12345

# Orígenes permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:3001
